// Project-local debug tasks
//
// For more documentation on how to configure debug tasks,
// see: https://zed.dev/docs/debugger
[
  {
    "label": "Debug Mockers",
    "adapter": "CodeLLDB",
    "build": {
      "command": "cargo",
      "args": ["build"],
    },
    "program": "$ZED_WORKTREE_ROOT/target/debug/mockers",
    "args": ["serve", "--verbose", "--mocks", "mocks"],
    "request": "launch",
  },
]
