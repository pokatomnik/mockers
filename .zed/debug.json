[
  {
    "label": "Debug Mockers",
    "adapter": "CodeLLDB",
    "build": {
      "command": "cargo",
      "args": ["build"],
    },
    "program": "$ZED_WORKTREE_ROOT/target/debug/mockers",
    "args": [
      "serve",
      "--verbose",
      "--mocks",
      "mocks",
      "--admin-base-url",
      "/__admin",
    ],
    "request": "launch",
  },
]
