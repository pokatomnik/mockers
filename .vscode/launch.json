  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug executable 'mockers'",
      "type": "lldb",
      "request": "launch",
      "cwd": "${workspaceFolder}/.my",
      "cargo": {
        "cwd": "${workspaceFolder}/.my",
        "args": ["run", "--bin=mockers"]
      },
      "args": ["serve", "--origin", "https://api.apis.guru"]
    },
    {
      "name": "Debug unit tests in executable 'mockers'",
      "type": "lldb",
      "request": "launch",
      "cwd": "${workspaceFolder}/.my",
      "cargo": {
        "cwd": "${workspaceFolder}/.my",
        "args": ["test", "--bin=mockers"]
      }
    }
  ]
}
